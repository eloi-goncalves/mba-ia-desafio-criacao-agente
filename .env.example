# Variáveis de ambiente do assistente do Residencial Aurora.
# Copie este arquivo para .env e preencha os valores. O .env NÃO é versionado.

# Chave do Google AI Studio usada pelos modelos Gemini via Google ADK.
GOOGLE_API_KEY=

# Usa o Google AI Studio (e não o Vertex AI). Mantenha como FALSE para este desafio.
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Modelo Gemini usado pelos agentes. Consulte os modelos disponíveis e os limites
# ativos do seu projeto no Google AI Studio (eles mudam com frequência).
GEMINI_MODEL=gemini-2.0-flash
